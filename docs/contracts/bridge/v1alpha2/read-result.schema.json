{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mctl.ai/schemas/bridge/v1alpha2/read-result.schema.json",
  "title": "Bridge read result (provider worker -> mctl-api), v1alpha2",
  "description": "Carries no tenant_ref, principal_ref, connection_ref or install_revision_ref: bindings come only from the consumer's own command row. payload and payload_digest are present iff outcome is succeeded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "request_id",
    "kind",
    "lease_token",
    "attempt",
    "worker_identity",
    "outcome",
    "provider_effect",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "bridge.mctl.ai/v1alpha2"
    },
    "command_id": {
      "type": "string",
      "pattern": "^cmd_[A-Za-z0-9]{26}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^rdq_[A-Za-z0-9]{26}$"
    },
    "kind": {
      "enum": [
        "read_history",
        "read_preview",
        "read_basket"
      ]
    },
    "lease_token": {
      "type": "string",
      "pattern": "^lt_[A-Za-z0-9_-]{16,64}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "worker_identity": {
      "type": "string",
      "pattern": "^provider:[a-z0-9-]{1,32}$"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed_retryable",
        "failed_terminal",
        "cancelled"
      ]
    },
    "provider_effect": {
      "const": "none"
    },
    "error_code": {
      "enum": [
        "none",
        "stale_lease",
        "expired",
        "provider_unavailable",
        "provider_rejected",
        "payload_too_large",
        "internal"
      ]
    },
    "error_detail": {
      "type": "string",
      "pattern": "^[ -~]{1,128}$",
      "maxLength": 128
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "payload": {
      "type": "object"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "required": [
          "payload",
          "payload_digest"
        ]
      },
      "else": {
        "properties": {
          "payload": false,
          "payload_digest": false
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "read_history"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_read_history"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "read_preview"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_read_preview"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "read_basket"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/payload_read_basket"
          }
        }
      }
    }
  ],
  "$defs": {
    "item_code": {
      "type": "string",
      "pattern": "^FAKE-[A-Z0-9-]{1,32}$"
    },
    "display_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 .,'()-]{1,60}$"
    },
    "placed_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "history_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_code",
        "quantity"
      ],
      "properties": {
        "item_code": {
          "$ref": "#/$defs/item_code"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "history_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_order_ref",
        "placed_on",
        "status",
        "total_minor",
        "currency",
        "line_count",
        "lines"
      ],
      "properties": {
        "history_order_ref": {
          "type": "string",
          "pattern": "^pho_[A-Za-z0-9]{16,40}$"
        },
        "placed_on": {
          "$ref": "#/$defs/placed_on"
        },
        "status": {
          "enum": [
            "delivered",
            "cancelled",
            "in_progress"
          ]
        },
        "total_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "line_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/history_line"
          }
        }
      }
    },
    "display_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_code",
        "item_name"
      ],
      "properties": {
        "item_code": {
          "$ref": "#/$defs/item_code"
        },
        "item_name": {
          "$ref": "#/$defs/display_name"
        }
      }
    },
    "payload_read_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orders"
      ],
      "properties": {
        "orders": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/history_order"
          }
        },
        "next_cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      }
    },
    "payload_read_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "empty",
        "display",
        "unavailable_items"
      ],
      "properties": {
        "empty": {
          "type": "boolean"
        },
        "display": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/display_entry"
          }
        },
        "unavailable_items": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/item_code"
          }
        },
        "approval_basket": {
          "$ref": "approval-basket.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "empty"
            ],
            "properties": {
              "empty": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "approval_basket": false,
              "display": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "required": [
              "approval_basket"
            ]
          }
        }
      ]
    },
    "payload_read_basket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "empty",
        "display"
      ],
      "properties": {
        "empty": {
          "type": "boolean"
        },
        "store_name": {
          "$ref": "#/$defs/display_name"
        },
        "display": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/display_entry"
          }
        },
        "approval_basket": {
          "$ref": "approval-basket.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "empty"
            ],
            "properties": {
              "empty": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "approval_basket": false,
              "display": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "required": [
              "approval_basket"
            ]
          }
        }
      ]
    }
  }
}
