{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mctl.ai/schemas/bridge/v1alpha2/read-command.schema.json",
  "title": "Bridge read command (mctl-api -> provider worker), v1alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "request_id",
    "kind",
    "attempt",
    "tenant_ref",
    "principal_ref",
    "connection_ref",
    "install_revision_ref",
    "issuer",
    "audience",
    "nonce",
    "issued_at",
    "expires_at",
    "ttl_seconds",
    "params"
  ],
  "properties": {
    "schema_version": {
      "const": "bridge.mctl.ai/v1alpha2"
    },
    "command_id": {
      "type": "string",
      "pattern": "^cmd_[A-Za-z0-9]{26}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^rdq_[A-Za-z0-9]{26}$"
    },
    "kind": {
      "enum": [
        "read_history",
        "read_preview",
        "read_basket"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^tnr_[A-Za-z0-9]{16,40}$"
    },
    "principal_ref": {
      "type": "string",
      "pattern": "^prr_[A-Za-z0-9]{16,40}$"
    },
    "connection_ref": {
      "type": "string",
      "pattern": "^gcn_[A-Za-z0-9]{16,40}$"
    },
    "install_revision_ref": {
      "type": "string",
      "pattern": "^irv_[A-Za-z0-9]{16,40}$"
    },
    "issuer": {
      "const": "mctl-api"
    },
    "audience": {
      "type": "string",
      "pattern": "^provider:[a-z0-9-]{1,32}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "lease_token": {
      "type": "string",
      "pattern": "^lt_[A-Za-z0-9_-]{16,64}$"
    },
    "params": {
      "type": "object"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "execution_id"
        ]
      },
      {
        "required": [
          "work_item_id"
        ]
      },
      {
        "required": [
          "order_ref"
        ]
      },
      {
        "required": [
          "workflow_id"
        ]
      },
      {
        "required": [
          "approval_ref"
        ]
      },
      {
        "required": [
          "intent_hash"
        ]
      }
    ]
  },
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "read_history"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/params_read_history"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "read_preview"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/params_read_preview"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "read_basket"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/params_read_basket"
          }
        }
      }
    }
  ],
  "$defs": {
    "params_read_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "cursor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      }
    },
    "params_read_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_order_ref"
      ],
      "properties": {
        "history_order_ref": {
          "type": "string",
          "pattern": "^pho_[A-Za-z0-9]{16,40}$"
        }
      }
    },
    "params_read_basket": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {},
      "maxProperties": 0
    }
  }
}
