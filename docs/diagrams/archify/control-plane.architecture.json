  "cards": [
    {
      "dot": "cyan",
      "title": "One API for humans and agents",
      "items": [
        "71 MCP tools behind OAuth 2.1 PKCE \u2014 the same surface an operator and an agent use",
        "Agent registry: definition \u2192 immutable version \u2192 per-environment release"
      ]
    },
    {
      "dot": "amber",
      "title": "Durable orchestration, sandboxed judgement",
      "items": [
        "Temporal holds waits for days; a worker isolation test forbids the SDK in-process",
        "Argo pods run the model with a USD budget, a wall-clock deadline and a gitops mutex"
      ]
    },
    {
      "dot": "emerald",
      "title": "Everything is a commit",
      "items": [
        "Proposals, status and approvals live in mctl-gitops as reviewable files",
        "Merged PRs release through ArgoCD; the loop then watches rollout and incidents"
      ]
    }
  ]
