        "label": "Control plane",
        "focus": [
          "operator",
          "mctlapi",
          "temporal",
          "registry"
        ],
        "note": "Humans and agents share one API. Temporal owns durable state; the registry owns which agent version may run."
      },
      {
        "id": "sandbox",
        "label": "Sandboxed execution",
        "focus": [
          "mctlapi",
          "argo",
          "agentpod",
          "anthropic",
          "vault"
        ],
        "note": "The Claude Agent SDK only ever runs inside an Argo pod with a scoped budget, timeout and mutex \u2014 never inside the Temporal worker."
      },
      {
        "id": "evidence",
        "label": "Evidence and delivery",
        "focus": [
          "agentpod",
          "github",
          "gitops",
          "argocd",
          "observability"
        ],
        "note": "Every agent action lands as a commit, PR or status file. GitHub is authoritative; gitops is the durable projection ArgoCD deploys from."
      }
    ]
  },
