{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Dev Loop \u2014 one GitHub issue, end to end",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "propose",
        "label": "Issue to approved proposal",
        "focus": [
          "issue",
          "start",
          "investigate",
          "pod_inv",
          "wait",
          "approve"
        ],
        "note": "An agent turns the issue into a reviewable proposal, then the loop parks \u2014 for hours or days \u2014 until a human approves."
      },
      {
        "id": "ship",
        "label": "Implement, review, merge",
        "focus": [
          "implement",
          "pod_impl",
          "watchpr",
          "review",
          "pod_shep"
        ],
        "note": "The implementer opens a PR; review bots gate it; the shepherd addresses findings and merges with the head SHA pinned."
      },
      {
        "id": "observe",
        "label": "Observe what shipped",
        "focus": [
          "watchpr",
          "deploy",
          "notmerged",
          "noship"
        ],
        "note": "After merge the same workflow waits for the release, watches the rollout, and opens a 30-minute incident window."
      }
    ]
  },
  "lanes": [
