  "cards": [
    {
      "dot": "amber",
      "title": "One human gate",
      "items": [
        "Everything before it (investigate) and after it (approve, implement, merge, observe) is automatic",
        "Temporal holds the wait for free \u2014 no pod, no cron, no lost state"
      ]
    },
    {
      "dot": "cyan",
      "title": "Pinned versions",
      "items": [
        "The loop resolves the agent release once, at the step that uses it",
        "A promote or rollback never changes an in-flight or replayed execution"
      ]
    },
    {
      "dot": "rose",
      "title": "Merge is earned",
      "items": [
        "Review bots must leave 0 unaddressed P1/P2 findings",
        "gh pr merge --merge --match-head-commit: a late push cannot smuggle code through"
      ]
    }
  ]
