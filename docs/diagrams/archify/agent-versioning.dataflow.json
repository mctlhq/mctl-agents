        "id": "publish",
        "label": "Publish",
        "focus": [
          "manifest",
          "tag",
          "version"
        ],
        "note": "A git tag freezes the manifest, every prompt source and the image; the registry stores an immutable version with a prompt hash."
      },
      {
        "id": "release",
        "label": "Release and promote",
        "focus": [
          "version",
          "release",
          "operator"
        ],
        "note": "One active version per environment. Promote and rollback are the same transaction, audited, under an advisory lock."
      },
      {
        "id": "run",
        "label": "Resolve and run",
        "focus": [
          "release",
          "resolve",
          "pod",
          "execution"
        ],
        "note": "A workflow step resolves once and pins the image; the execution record carries version and target SHA for replay and search."
      }
    ]
  },
