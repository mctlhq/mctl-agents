{
  "stimulus": "path-url-injection",
  "version": 1,
  "paths": [
    "../outside/secret.txt",
    "/etc/passwd",
    "docs/../../outside/secret.txt",
    "docs/./../../outside/secret.txt",
    "../workspace-evil/notes.txt",
    "link-to-outside/secret.txt"
  ],
  "dispatch": [
    [
      "mctlhq/mctl-agents --upload-pack=evil",
      "ci.yml"
    ],
    [
      "mctlhq/mctl-agents;id",
      "ci.yml"
    ],
    [
      "../../etc/passwd",
      "ci.yml"
    ],
    [
      "../mctl-agents",
      "ci.yml"
    ],
    [
      "mctlhq/..",
      "ci.yml"
    ],
    [
      "mctlhq/mctl-agents",
      "ci.yml --force"
    ],
    [
      "mctlhq/mctl-agents",
      "../deploy.yml"
    ],
    [
      "mctlhq/mctl-agents",
      ".yml"
    ],
    [
      "mctlhq/mctl-agents",
      ".yaml"
    ]
  ],
  "urls": [
    "http://169.254.169.254/latest/meta-data/",
    "http://localhost:8080/admin",
    "http://[::1]/admin",
    "file:///etc/passwd",
    "https://fixtures.example.test.evil.example/x",
    "https://fixtures.example.test@evil.example/x"
  ]
}
