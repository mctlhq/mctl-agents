{
  "_header": {
    "purpose": "Frozen human-written oracle for the TEST-ONLY offline synthetic log-span pilot (Refs mctlhq/mctl-agents#1073).",
    "provenance": "Every log below is INVENTED by hand or by a trivial repeat template. None is a real CI log and none is a real workload measurement.",
    "oracle_frozen_before_selector": "required/acceptable/expected_state were written before the test-local selector existed and must not be edited to favour it.",
    "oracle_matching": "required and acceptable are exact line texts (a trailing CR is ignored when matching). required = lines a reader needs to name the root cause. acceptable = genuine supporting evidence that is NOT noise when emitted but is not required. Any emitted line in neither list is noise.",
    "line_interpretation": "A log is the UTF-8 bytes of join(eol, lines) plus eol when final_newline is true. Pilot line numbers are 1-based, inclusive, LF-separated; a CR from CRLF stays inside its line.",
    "identity": "source_sha256 is the SHA-256 of the original UTF-8 bytes only. It identifies a fixture; it is not an authenticated execution.",
    "segments": "A segment is a literal line or {\"repeat\": {\"template\": str.format with i, \"start\": int, \"count\": int}}.",
    "expected_state": "Independent human label: failure | healthy | unknown | empty. Category labels are explanatory only, not a diagnosis taxonomy.",
    "credential_note": "Credential-shaped strings are obviously fake (EXAMPLE) and only exercise the recognized-shape screen; this is not comprehensive secret detection."
  },
  "cases": [
    {
      "id": "01-middle-root-cause",
      "group": "case",
      "category": "root cause in the middle of a log longer than the comparison cap",
      "eol": "\n",
      "final_newline": true,
      "segments": [
        "##[group]Run make build",
        {"repeat": {"template": "[build] compiling module {i:04d} of 0300 ... ok", "start": 1, "count": 150}},
        "[build] compiling module 0151 of 0300 ...",
        "error: linker command failed: undefined reference to `render_frame_v2'",
        "  referenced by module 0151 (render.o)",
        {"repeat": {"template": "[build] compiling module {i:04d} of 0300 ... ok", "start": 152, "count": 149}},
        "##[endgroup]",
        "Process completed with exit code 2."
      ],
      "expected_state": "failure",
      "oracle": {
        "required": ["error: linker command failed: undefined reference to `render_frame_v2'"],
        "acceptable": ["  referenced by module 0151 (render.o)", "Process completed with exit code 2."]
      },
      "must_exceed_cap": true,
      "baseline_expected_to_lose_required_line": true,
      "source_sha256": "4368cfada8aa840454644fed9bbdfc26a700ce96e158df8ee37aeeffb021e2a8"
    },
    {
      "id": "02-stack-trace-required-vs-acceptable",
      "group": "case",
      "category": "stack trace: exception line required, frames acceptable",
      "eol": "\n",
      "final_newline": true,
      "segments": [
        "$ pytest -q tests/",
        "collected 12 items",
        "tests/test_a.py ..........",
        "tests/test_b.py .F",
        "=================================== FAILURES ===================================",
        "______________________________ test_total ______________________________",
        "Traceback (most recent call last):",
        "  File \"tests/test_b.py\", line 14, in test_total",
        "    assert compute_total(items) == 3",
        "  File \"app/totals.py\", line 7, in compute_total",
        "    return sum(i.qty for i in items) + 1",
        "AssertionError: expected 3 got 4",
        "=========================== short test summary info ============================",
        "FAILED tests/test_b.py::test_total - AssertionError: expected 3 got 4",
        "1 failed, 11 passed in 0.42s"
      ],
      "expected_state": "failure",
      "oracle": {
        "required": ["AssertionError: expected 3 got 4"],
        "acceptable": [
          "Traceback (most recent call last):",
          "  File \"tests/test_b.py\", line 14, in test_total",
          "    assert compute_total(items) == 3",
          "  File \"app/totals.py\", line 7, in compute_total",
          "    return sum(i.qty for i in items) + 1",
          "FAILED tests/test_b.py::test_total - AssertionError: expected 3 got 4",
          "1 failed, 11 passed in 0.42s",
          "tests/test_b.py .F"
        ]
      },
      "source_sha256": "790a4dbae76378763f2bbe0dc79b2c8453535b2e7ccad6dfbc9370bb20d79a67"
    },
    {
      "id": "03-fatal-and-recovered",
      "group": "case",
      "category": "recovered error earlier, fatal error later",
      "eol": "\n",
      "final_newline": true,
      "segments": [
        "[deploy] fetching artifact layers",
        "ERROR: connection reset by peer while fetching layer 3, retrying (1/3)",
        "WARN: retry succeeded, recovered after 1 attempt",
        "[deploy] applying migrations",
        "[deploy] migration 0041 ok",
        "FATAL: migration 0042 failed: duplicate column \"owner_id\"",
        "[deploy] rolling back",
        "[deploy] rollback complete",
        "Process completed with exit code 1."
      ],
      "expected_state": "failure",
      "oracle": {
        "required": ["FATAL: migration 0042 failed: duplicate column \"owner_id\""],
        "acceptable": ["Process completed with exit code 1."]
      },
      "note": "The early ERROR line was recovered; it is not the root cause, so emitting it is noise.",
      "source_sha256": "269f79454ea883f9585821f51c9485cf34521d701a8bb7a788980d8fe1fd878c"
    },
