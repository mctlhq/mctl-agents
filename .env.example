# === Auth: укажи ОДИН из двух ===

# Режим 1: OAuth-токен от Claude Pro/Max подписки.
# Получить: `npm i -g @anthropic-ai/claude-code` -> `claude setup-token`
# Префикс: sk-ant-oat01-...
# Подходит для: личного использования, прототипов.
# Минусы: 5-часовые лимиты подписки, refresh может отозваться, "серая зона" по ToS для third-party продуктов.
CLAUDE_CODE_OAUTH_TOKEN=

# Режим 2: API-ключ из Anthropic Console.
# Получить: https://console.anthropic.com/settings/keys
# Префикс: sk-ant-api03-...
# Подходит для: production, долгоживущих агентов, деплоя в кластер.
# Биллинг: pay-per-token, можно поставить monthly cap.
ANTHROPIC_API_KEY=

# === mctl MCP ===
# Bearer-токен для https://api.mctl.ai/mcp
MCTL_TOKEN=

# === Опционально ===
# Профили model policy (config/model-policy.yaml)
CLAUDE_CHEAP_MODEL=claude-haiku-4-5
CLAUDE_BALANCED_MODEL=claude-sonnet-5

# Обратная совместимость: task-specific overrides имеют приоритет
# над соответствующим профилем.
SERVICE_AGENT_MODEL=claude-sonnet-5

# Ментор и shepherd по умолчанию используют cheap-профиль.
MENTOR_MODEL=
SHEPHERD_MODEL=

# === Lifecycle ExecutionClaim (ADR-010 phase 2, mctl-agents#352) ===
# Claim lease duration, in seconds. Both are LENGTHEN-ONLY: a value shorter
# than the lease the code computes is refused with a log line and the computed
# lease is used instead, because a claim that expires under the run holding it
# comes back from the push-site check as CLAIM_UNCLAIMED and stands a valid
# attempt down (claude P3 on `b362b5e`). Set one only to hold a claim LONGER.
#   IMPLEMENT: computes 130 minutes, the `attempt` lease it replaces.
#   REVIEW:    computes a FLOOR of 30 minutes (one MERGE_POLL_INTERVAL),
#              raised to IMPLEMENTER_TIMEOUT_CEILING_SECONDS + 2 x
#              IMPLEMENTER_COMMAND_TIMEOUT_SECONDS whenever that is larger, so
#              the lease outlives the run it guards. mctl-agents#423: the
#              CEILING, not IMPLEMENTER_TIMEOUT_SECONDS alone — a
#              CI-remediation or mixed follow-up can widen its own envelope up
#              to the ceiling before its work class is even known. With the
#              stock 1800 + 2 x 300 the computed 2400 wins over the 1800
#              floor; raise IMPLEMENTER_TIMEOUT_CEILING_SECONDS and the lease
#              follows it on its own — an active `=1800` here no longer
#              clamps it, it is simply ignored (agy P2 on `0af3b38`).
# Both stay commented out so nothing copied from this file pins a lease it did
# not mean to; uncommenting a LARGER value is the supported way to widen one.
# LIFECYCLE_CLAIM_LEASE_SECONDS_IMPLEMENT=7800
# LIFECYCLE_CLAIM_LEASE_SECONDS_REVIEW=1800

# === Context assembly pilot (mctlhq/mctl-agents#265, ADR 009) ===
# One of: off (default — no collector runs, no snapshot is sealed, prompt is
# unchanged), shadow (assemble/seal/log a ContextSnapshot, prompt unchanged —
# the baseline-metrics mode), on (also appends included sources to the
# prompt). Read fresh per call; unset or "off" is the safe rollback.
# ISSUE_INVESTIGATOR_CONTEXT_MODE=off
# Assembly budget, all overridable, all recorded inside the sealed
# snapshot's `budget` block.
# ISSUE_INVESTIGATOR_CONTEXT_MAX_SOURCES=12
# ISSUE_INVESTIGATOR_CONTEXT_MAX_BYTES=120000
# ISSUE_INVESTIGATOR_CONTEXT_MAX_BYTES_PER_SOURCE=50000

# === PR adoption (mctlhq/mctl-agents#334) ===
# Lets the shepherd adopt a proposal-less, same-repo, non-fork PR that has
# fresh blocking (P1/P2) review findings, and drive it through the existing
# review-feedback fix loop, FIX_ONLY (never merge). All three default to
# "nothing changes": with SHEPHERD_ADOPT_PRS unset and SHEPHERD_ADOPT_REPOS
# empty, run_shepherd's observable behaviour is unchanged. Do not enable in
# production before mctlhq/mctl-gitops#1278 lands — see README.md's
# "Adopted PRs" section for the durability caveat.
# SHEPHERD_ADOPT_PRS=false
# SHEPHERD_ADOPT_REPOS=
# SHEPHERD_ADOPT_MAX_PRS_PER_TICK=1

# === Required-check remediation (mctlhq/mctl-agents#411) ===
# The shepherd's merge gate is the union of semantic-review findings AND
# failing REQUIRED checks on the PR's current head. All three default to
# today's tuning; uncomment only to change it.
# Max `gh run rerun --failed` attempts per head SHA when the only
# current-head blockers are required checks classified as infrastructure
# failures (cancelled/timed out/runner lost/...). Never charges
# review_attempts; exhausting the budget flips to review-stuck, blamelessly.
# SHEPHERD_CI_INFRA_RERUN_MAX=2
# Max consecutive required-check probe failures before flipping to
# review-stuck. Cleared on any successful probe; never charges
# review_attempts.
# SHEPHERD_CI_PROBE_FAILURES_MAX=6
# Comma/whitespace-separated allowlist of check names treated as required
# when GitHub reports no per-context isRequired signal AND the branch
# protection context list is silent on them too. Unset = no override
# (advisory is the safe default when both real signals are absent).
# SHEPHERD_CI_REQUIRED_OVERRIDE=

# === CI-remediation execution budget (mctl-agents#423) ===
# See docs/adr/011-execution-budget-contract.md for the full coverage table.
# Retrieval (in the shepherd process, OUTSIDE the implementer's envelope):
# per-fetch timeout, per-bundle time budget, and a kill switch that restores
# the pre-#423 annotation-only bundle shape without a redeploy.
# SHEPHERD_CI_LOG_TIMEOUT_SECONDS=45
# SHEPHERD_CI_LOG_BUDGET_SECONDS=120
# SHEPHERD_CI_LOG_FETCH=true
# Envelope (inside the implementer): per-check analysis budget added to
# IMPLEMENTER_TIMEOUT_SECONDS for a CI-remediation/mixed run, capped at
# CI_LOG_MAX_CHECKS checks (orchestrator/ci_checks.py) and at the ceiling
# below. The review-only class is unaffected — it keeps
# IMPLEMENTER_TIMEOUT_SECONDS exactly, unconditionally.
# IMPLEMENTER_CI_ANALYSIS_SECONDS=120
# IMPLEMENTER_TIMEOUT_CEILING_SECONDS=1800
# Reserve that must survive drain/teardown so an envelope that analysed its
# evidence still has time left to mutate code and commit.
# IMPLEMENTER_MUTATION_RESERVE_SECONDS=180
# Bound on the shielded teardown when the envelope expires with a delegated
# task still live: disconnect the SDK client and terminate its CLI child
# before the process exits, rather than abandoning them.
# IMPLEMENTER_TEARDOWN_GRACE_SECONDS=15

# === Implement-sweep (mctl-agents#412) ===
# The `implement-sweep-mctl-agents-schedule` tick that turns an `accepted`
# proposal no live DevLoopWorkflow owns back into an implementer run.
# Both parsed as a positive integer at worker startup — a malformed or
# non-positive value is a startup refusal (SystemExit), the same rule
# IMPLEMENTATION_MAX_CONCURRENT_ACTIVITIES follows, not a silent default.
#
# Grace period, minutes: how long a freshly `updated_at` `accepted` proposal
# is left alone before the sweep will call it stranded. 20 exceeds
# dev_loop.APPROVE_STEP_TIMEOUT (15 min), so a DevLoopWorkflow that just
# flipped the approve but has not yet submitted its own implement step is
# always still inside the window.
# IMPLEMENT_SWEEP_GRACE_MINUTES=20
# Per-tick submit cap: how many implementer runs one tick may start after a
# long outage. The real concurrency bound is
# IMPLEMENTATION_MAX_CONCURRENT_ACTIVITIES; this only limits how many
# children one tick mints at once.
# IMPLEMENT_SWEEP_MAX_SUBMITS=5
