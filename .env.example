# === Auth: укажи ОДИН из двух ===

# Режим 1: OAuth-токен от Claude Pro/Max подписки.
# Получить: `npm i -g @anthropic-ai/claude-code` -> `claude setup-token`
# Префикс: sk-ant-oat01-...
# Подходит для: личного использования, прототипов.
# Минусы: 5-часовые лимиты подписки, refresh может отозваться, "серая зона" по ToS для third-party продуктов.
CLAUDE_CODE_OAUTH_TOKEN=

# Режим 2: API-ключ из Anthropic Console.
# Получить: https://console.anthropic.com/settings/keys
# Префикс: sk-ant-api03-...
# Подходит для: production, долгоживущих агентов, деплоя в кластер.
# Биллинг: pay-per-token, можно поставить monthly cap.
ANTHROPIC_API_KEY=

# === mctl MCP ===
# Bearer-токен для https://api.mctl.ai/mcp
MCTL_TOKEN=

# === Опционально ===
# Профили model policy (config/model-policy.yaml)
CLAUDE_CHEAP_MODEL=claude-haiku-4-5
CLAUDE_BALANCED_MODEL=claude-sonnet-5

# Обратная совместимость: task-specific overrides имеют приоритет
# над соответствующим профилем.
SERVICE_AGENT_MODEL=claude-sonnet-5

# Ментор и shepherd по умолчанию используют cheap-профиль.
MENTOR_MODEL=
SHEPHERD_MODEL=

# === Lifecycle ExecutionClaim (ADR-010 phase 2, mctl-agents#352) ===
# Claim lease duration, in seconds. Both are LENGTHEN-ONLY: a value shorter
# than the lease the code computes is refused with a log line and the computed
# lease is used instead, because a claim that expires under the run holding it
# comes back from the push-site check as CLAIM_UNCLAIMED and stands a valid
# attempt down (claude P3 on `b362b5e`). Set one only to hold a claim LONGER.
#   IMPLEMENT: computes 130 minutes, the `attempt` lease it replaces.
#   REVIEW:    computes a FLOOR of 30 minutes (one MERGE_POLL_INTERVAL),
#              raised to IMPLEMENTER_TIMEOUT_SECONDS + 2 x
#              IMPLEMENTER_COMMAND_TIMEOUT_SECONDS whenever that is larger, so
#              the lease outlives the run it guards. With the stock 900 + 2 x
#              300 the floor wins at 1800; raise IMPLEMENTER_TIMEOUT_SECONDS
#              and the lease follows it on its own — an active `=1800` here no
#              longer clamps it, it is simply ignored (agy P2 on `0af3b38`).
# Both stay commented out so nothing copied from this file pins a lease it did
# not mean to; uncommenting a LARGER value is the supported way to widen one.
# LIFECYCLE_CLAIM_LEASE_SECONDS_IMPLEMENT=7800
# LIFECYCLE_CLAIM_LEASE_SECONDS_REVIEW=1800

# === Context assembly pilot (mctlhq/mctl-agents#265, ADR 009) ===
# One of: off (default — no collector runs, no snapshot is sealed, prompt is
# unchanged), shadow (assemble/seal/log a ContextSnapshot, prompt unchanged —
# the baseline-metrics mode), on (also appends included sources to the
# prompt). Read fresh per call; unset or "off" is the safe rollback.
# ISSUE_INVESTIGATOR_CONTEXT_MODE=off
# Assembly budget, all overridable, all recorded inside the sealed
# snapshot's `budget` block.
# ISSUE_INVESTIGATOR_CONTEXT_MAX_SOURCES=12
# ISSUE_INVESTIGATOR_CONTEXT_MAX_BYTES=120000
# ISSUE_INVESTIGATOR_CONTEXT_MAX_BYTES_PER_SOURCE=50000
